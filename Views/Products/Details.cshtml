@model Product
@{ ViewData["Title"] = "Product details"; }
<h1>Product details</h1>
<dl><dt>ID</dt><dd>@Model.ID</dd><dt>Name</dt><dd>@Model.Name</dd><dt>Price</dt><dd>@Model.Price</dd><dt>Description</dt><dd>@Model.Description</dd><dt>Category</dt><dd>@Model.Category.Name</dd><dt>Category details</dt><dd><a asp-controller="Categories" asp-action="Details" asp-route-id="@Model.CategoryID">View @Model.Category.Name</a></dd></dl>

<p><a asp-action="Edit" asp-route-id="@Model.ID">Edit</a><a class="back" asp-action="Index">Back to list</a></p>
