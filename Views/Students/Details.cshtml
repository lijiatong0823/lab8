@model Student
@{ ViewData["Title"] = "Student details"; }
<h1>Student details</h1>
<dl><dt>ID</dt><dd>@Model.ID</dd><dt>Name</dt><dd>@Model.Name</dd><dt>Address</dt><dd>@Model.Address</dd><dt>Campus</dt><dd>@Model.Campus.Name</dd><dt>Campus details</dt><dd><a asp-controller="Campuses" asp-action="Details" asp-route-id="@Model.CampusID">View @Model.Campus.Name</a></dd></dl>

<p><a asp-action="Edit" asp-route-id="@Model.ID">Edit</a><a class="back" asp-action="Index">Back to list</a></p>
