@model IReadOnlyList<Student>
<table><thead><tr><th>ID</th><th>Name</th><th>Address</th><th>Campus</th><th>Actions</th></tr></thead><tbody>
@foreach (var item in Model)
{
    <tr><td>@item.ID</td><td>@item.Name</td><td>@item.Address</td><td>@item.Campus.Name</td><td class="actions"><a asp-action="Details" asp-route-id="@item.ID">Details</a><a asp-action="Edit" asp-route-id="@item.ID">Edit</a><a asp-action="Delete" asp-route-id="@item.ID">Delete</a></td></tr>
}
@if (Model.Count == 0)
{
    <tr><td colspan="5">No students match these filters.</td></tr>
}
</tbody></table>
