@model Category
@{ ViewData["Title"] = "Category details"; }
<h1>Category details</h1>
<dl><dt>ID</dt><dd>@Model.ID</dd><dt>Name</dt><dd>@Model.Name</dd><dt>Products</dt><dd>@Model.Products.Count</dd></dl>

<h2>Products</h2>
<table><thead><tr><th>ID</th><th>Name</th><th>Price</th></tr></thead><tbody>
@foreach (var child in Model.Products.OrderBy(child => child.Name))
{
<tr><td>@child.ID</td><td><a asp-controller="Products" asp-action="Details" asp-route-id="@child.ID">@child.Name</a></td><td>@child.Price</td></tr>
}
</tbody></table>
<p><a asp-action="Edit" asp-route-id="@Model.ID">Edit</a><a class="back" asp-action="Index">Back to list</a></p>
